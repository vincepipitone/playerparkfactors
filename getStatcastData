all_game_pks = (
    trimmed_statcast["game_pk"]
    .dropna()
    .astype(int)
    .unique()
)

print("Total games:", len(all_game_pks))


# -----------------------------------------
# 2) Fetch condition
# -----------------------------------------
rows = []

for i, gp in enumerate(all_game_pks, start=1):
    url = f"https://statsapi.mlb.com/api/v1.1/game/{gp}/feed/live"

    try:
        r = requests.get(url, timeout=20)
        r.raise_for_status()
        data = r.json()

        condition = data.get("gameData", {}).get("weather", {}).get("condition", None)

        rows.append({
            "game_pk": gp,
            "condition": condition
        })

    except Exception:
        rows.append({
            "game_pk": gp,
            "condition": None
        })

    # Be polite to API
    time.sleep(0.12)

    if i % 250 == 0:
        print(f"Processed {i}/{len(all_game_pks)} games")

conditions_df = pd.DataFrame(rows)

print("\nDone.")
print("Missing rate:", conditions_df["condition"].isna().mean())
print(conditions_df.head())

trimmed_statcast = trimmed_statcast.merge(
    conditions_df,
    on="game_pk",
    how="left"
)
