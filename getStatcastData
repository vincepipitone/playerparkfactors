import re
import time

import numpy as np
import pandas as pd
import requests
from pybaseball import statcast

# Pull multi-season data (example)
df = statcast(start_dt="2023-03-01", end_dt="2025-11-30")

# Keep balls in play only
df = df[df["type"] == "X"]  # contact events

# Calculate spray_angle given Petti's equation

x = df["hc_x"].to_numpy(dtype=float)
y = df["hc_y"].to_numpy(dtype=float)

df["spray_angle"] = np.round(
    np.degrees(
        np.arctan2(
            x - 125.42,
            198.27 - y
        )
    ) * 0.75,
    1
)

df = df[~df["game_type"].isin(["E", "S"])]

trimmed_statcast = df[
    [
        "game_pk",
        "game_date",
        "batter",
        "pitcher",
        "events",
        "des",
        "stand",
        "p_throws",
        "home_team",
        "away_team",
        "hit_location",
        "bb_type",
        "game_year",
        "launch_speed",
        "launch_angle",
        "hc_x",
        "hc_y",
        "spray_angle",
        "estimated_ba_using_speedangle",
        "estimated_woba_using_speedangle"
    ]
].copy()

# 1) unique game_pks from trimmed_statcast
game_pks = (
    trimmed_statcast["game_pk"]
    .dropna()
    .astype(int)
    .unique()
)

# 2) lookup venue for each game_pk -> build `venues` DF
rows = []
for i, game_pk in enumerate(game_pks, start=1):
    url = f"https://statsapi.mlb.com/api/v1.1/game/{game_pk}/feed/live"
    stadium = None

    try:
        r = requests.get(url, timeout=20)
        r.raise_for_status()
        data = r.json()
        stadium = data.get("gameData", {}).get("venue", {}).get("name", None)
    except Exception:
        stadium = None

    rows.append({"game_pk": int(game_pk), "stadium": stadium})

    # be polite to the API
    time.sleep(0.15)

    if i % 500 == 0:
        print(f"Processed {i}/{len(game_pks)} games")

venues = pd.DataFrame(rows, columns=["game_pk", "stadium"])

print(venues.head())
print("Missing stadium rate:", venues["stadium"].isna().mean())

trimmed_statcast = trimmed_statcast.merge(
    venues,
    on="game_pk",
    how="left"
)

stadium_counts = (
    trimmed_statcast[["game_pk", "stadium"]]
    .drop_duplicates(subset="game_pk")   # one row per game
    .groupby("stadium", dropna=False)
    .size()
    .reset_index(name="game_count")
    .sort_values("game_count", ascending=False)
)

stadium_counts

