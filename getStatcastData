# --------------------------------------------------
# 2) Temperature fetch function
# --------------------------------------------------
def get_first_pitch_temp(game_pk, timeout=20):
    url = f"https://statsapi.mlb.com/api/v1.1/game/{game_pk}/feed/live"

    r = requests.get(url, timeout=timeout)
    r.raise_for_status()
    data = r.json()

    temp_raw = data.get("gameData", {}).get("weather", {}).get("temp", None)

    temp_f = np.nan
    if temp_raw is not None:
        match = re.search(r"(-?\d+(?:\.\d+)?)", str(temp_raw))
        if match:
            temp_f = float(match.group(1))

    return temp_f


# --------------------------------------------------
# 3) Loop through all games
# --------------------------------------------------
rows = []

for i, gp in enumerate(all_game_pks, start=1):
    try:
        temp = get_first_pitch_temp(gp)
        rows.append({"game_pk": gp, "temp_f": temp})
    except Exception:
        rows.append({"game_pk": gp, "temp_f": np.nan})

    # be polite to API
    time.sleep(0.12)

    if i % 250 == 0:
        print(f"Processed {i}/{len(all_game_pks)} games")

temps_all = pd.DataFrame(rows)

print("\nDone.")
print("Missing rate:", temps_all["temp_f"].isna().mean())
print(temps_all.head())

trimmed_statcast = trimmed_statcast.merge(
    temps_all,
    on="game_pk",
    how="left"
)

# -----------------------------------------
